# 文本文件上传时统一存 LF，按平台检出
* text=auto

# Windows 批处理必须是 CRLF，否则无法正常执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码与配置统一 LF，避免 CI(Linux) 与本地(Windows) 出现整文件差异
*.rs    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.ico   binary
*.jpg   binary
*.db    binary
