# ============ 依赖与构建产物 ============
node_modules/
dist/
src-tauri/target/

# ============ Tauri Android 源码 ============
# gen 下只放行 android 源码（Manifest/Kotlin/gradle/资源/wrapper），
# 排除 Gradle/Rust 构建产物与本机缓存。clone 后仍需 tauri android init 补齐骨架，
# 但自定义插件（后台保活/URI 适配）与权限改动会保留。
src-tauri/gen/*
!src-tauri/gen/android/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.kotlin/
src-tauri/gen/android/.tauri/
src-tauri/gen/android/local.properties
src-tauri/gen/android/keystore.properties
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/src/main/jniLibs/

# ============ 数据库与备份（含用户数据的文件绝不入库） ============
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
runhelp.db*
backups/
RunHelpBackups/

# ============ 密钥与凭据 ============
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_ed25519

# ============ Python ============
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ============ Agent 本地笔记（不入库） ============
# 开发经验手册 / 踩坑记录，持续更新，只在本机
.workbuddy/

# ============ 截图打码工作目录（含未打码原图，绝不入库） ============
.redact/

# ============ 编辑器 / 系统临时文件 ============
.vscode/
.vs/
.idea/
*.swp
*.swo
*.log
.DS_Store
Thumbs.db
desktop.ini

# ============ 打包临时产物 ============
dist_bak_*/
*.msi
*.exe
*.appx
*.dmg
*.AppImage
*.apk
