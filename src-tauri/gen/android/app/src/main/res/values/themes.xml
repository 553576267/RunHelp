<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 柔光青深色主题：窗口与系统栏同色，避免华为手势条区域出现白边 -->
    <style name="Theme.runhelp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sync_bg</item>
        <item name="android:statusBarColor">@color/sync_bg</item>
        <item name="android:navigationBarColor">@color/sync_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
