{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunHelp",
  "version": "0.1.0",
  "identifier": "com.runhelp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RunHelp",
        "width": 920,
        "height": 620,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "maximized": false,
        "dragDropEnabled": false,
        "backgroundColor": "#14161A"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
